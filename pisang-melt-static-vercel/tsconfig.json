{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "types": [
      "vite/client"
    ],

    "allowJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "allowImportingTsExtensions": true,

    "paths": {
      "@/*": [
        "./*"
      ]
    },

    "skipLibCheck": true,
    "noEmit": true
  },

  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}